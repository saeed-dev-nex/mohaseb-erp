# نمونهٔ متغیرهای محیطی محاسب پرو — این فایل را کپی و مقادیر واقعی را فقط
# در محیط اجرا تنظیم کنید؛ هرگز کلید واقعی را commit نکنید.
# Mohaseb Pro environment variables — copy the values into your real
# environment / .env file. Never commit a real secret key.

# (الزامی در محیط واقعی) کلید خصوصی تصادفی و ثابت جنگو
# Required in production; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# در محیط واقعی حتماً false باشد / Must be "false" in production
DJANGO_DEBUG=true

# نام میزبان‌های مجاز، جداشده با ویرگول / Comma-separated allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# مبدأهای مجاز فرانت‌اند (CORS)، جداشده با ویرگول
# مبدأ Firefox extension از نوع moz-extension به‌صورت محدود در تنظیمات مجاز است.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# سقف حجم آپلود در حافظه (بایت) — مقدار پیش‌فرض در settings.py
# DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=268435456

# نشانی پایهٔ API برای فرانت‌اند (اختیاری؛ در فرانت هنگام build تنظیم شود)
# VITE_API_URL=http://localhost:8000/api/

# مسیر فایل دیتابیس و فایل‌های آپلودشده (اختیاری؛ در Docker خودکار تنظیم می‌شود)
# DJANGO_DB_PATH=/data/db.sqlite3
# DJANGO_MEDIA_ROOT=/data/media

# منطقهٔ زمانی کسب‌وکار؛ پیش‌فرض محاسب پرو Asia/Tehran است
# DJANGO_TIME_ZONE=Asia/Tehran

# زمان‌بندی بکاپ داخلی در پردازهٔ Daphne؛ برای اجرای بیرونی خاموش کنید
# DJANGO_BACKUP_SCHEDULER_ENABLED=true

# --- Production (see docs/production-windows.md) ---
# Enable ONLY when the app is actually served over HTTPS, otherwise logins break:
# DJANGO_HTTPS=false
# Trust X-Forwarded-Proto/Host behind a TLS-terminating reverse proxy:
# DJANGO_BEHIND_PROXY=false
# Serve the built frontend + media from the app itself (single-port production):
# DJANGO_SERVE_FRONTEND=false
# DJANGO_FRONTEND_DIST=/path/to/frontend/dist

# دیتابیس خارجی (اختیاری) — پیش‌فرض SQLite محلی است؛ برای چند اپراتور
# هم‌زمان روی یک سرور می‌توانید PostgreSQL بدهید:
# Optional external database (default: local SQLite file):
# DATABASE_URL=postgres://user:password@db-host:5432/mohaseb

# لایهٔ وب‌سوکت خارجی (اختیاری) — پیش‌فرض حافظه‌ای است؛ وقتی backend در
# چند پروسه اجرا می‌شود Redis لازم است:
# Optional Redis channel layer for multi-process deployments:
# REDIS_URL=redis://127.0.0.1:6379/0

# ایمیل خروجی برای کدهای یکبارمصرف (تأیید ایمیل، بازیابی رمز، ورود با کد)
# Outgoing email for one-time codes; without EMAIL_HOST codes are printed
# to the backend server log instead of being emailed.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=
